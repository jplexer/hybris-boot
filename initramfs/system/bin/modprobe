#!/bin/busybox sh
B=/bin/busybox
log() { echo "PKVM-WRAPPER: $*" > /dev/kmsg 2>/dev/null; }
log "called with: $*"
while [ $# -gt 0 ]; do
    case "$1" in
        -q) shift ;;
        -d) shift 2 ;;
        --) shift; break ;;
        *)  break ;;
    esac
done
log "loading $1 (proc: $([ -e /proc/modules ] && echo yes || echo no))"
$B timeout 5 $B modprobe -v "$@" 2>&1 | while read -r l; do log "$l"; done
RET=$?
log "done $1 rc=$RET"
exit $RET

#!/bin/busybox sh
B=/bin/busybox
[ -c /dev/kmsg ] || { $B mkdir -p /dev; $B mknod /dev/kmsg c 1 11; }
echo on > /proc/sys/kernel/printk_devkmsg 2>/dev/null
log() { echo "PKVM-WRAPPER: $*" > /dev/kmsg 2>/dev/null; }

log "called: $*"
while [ $# -gt 0 ]; do
    case "$1" in
        -q) shift ;;
        -d) shift 2 ;;
        --) shift; break ;;
        *)  break ;;
    esac
done

# Tripwire: if loading takes > 8 s, panic so pstore keeps this log
( $B sleep 8; log "TRIPWIRE: '$1' still loading after 8s"; echo c > /proc/sysrq-trigger ) &
TRIP=$!

# Stream modprobe's verbose output into the kernel log as it happens
( $B modprobe -v "$@" 2>&1; echo $? > /modprobe.rc ) | while read -r l; do log "$l"; done
RET=$($B cat /modprobe.rc 2>/dev/null || echo 1)

$B kill $TRIP 2>/dev/null
log "done '$1' rc=$RET"
exit $RET

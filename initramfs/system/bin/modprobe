#!/bin/busybox sh
# Kernel calls this for early pKVM modules before /init runs.
# Android's ramdisk ships these nodes; ours doesn't, and static bionic
# binaries abort (SIGSEGV) when fds 0-2 are closed and /dev/null is missing.
B=/bin/busybox
[ -d /dev ] || $B mkdir /dev
[ -c /dev/null ]    || $B mknod -m 666 /dev/null    c 1 3
[ -c /dev/console ] || $B mknod -m 600 /dev/console c 5 1
[ -c /dev/urandom ] || $B mknod -m 666 /dev/urandom c 1 9
[ -c /dev/kmsg ]    || $B mknod -m 600 /dev/kmsg    c 1 11
exec /system/bin/real/modprobe "$@" </dev/null >/dev/kmsg 2>&1
